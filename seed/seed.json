		"speaking_page": [
			{
				"id": "speaking_page-main",
				"slug": "main",
				"status": "published",
				"data": {
					"title": "Speaking page",
					"kicker": "on stage, fedora included",
					"heading": "Speaking",
					"lead": "Talks and workshops on marketing, technology, and leadership, minus the hype. I make complex ideas easy to understand, and I bring that to the room.",
					"button": "Book Adam for your event",
					"photo_caption": "between sessions",
					"talks_kicker": "what I talk about",
					"talks_heading": "Talks",
					"talks": [
						{
							"tag": "Marketing",
							"title": "Best Practices Are Just Average Practices",
							"description": "Copying what everyone else does gets you average results. This talk shows how to spot the contrarian moves that actually fit your organization, and how to test them without betting the farm. For marketing teams, founders, and nonprofit leaders tired of playing it safe.",
							"formats": "Keynote · Workshop",
							"highlight": false
						},
						{
							"tag": "Technology",
							"title": "AI Without the Hype",
							"description": "A plain-English look at where AI saves real time for small teams and where it’s just a shiny distraction. Attendees leave with a short list of tools and habits they can put to work Monday morning. For nonprofit staff, executives, and small business owners.",
							"formats": "Keynote · Workshop",
							"highlight": true
						},
						{
							"tag": "Leadership",
							"title": "What 1,000 Days of Reading Taught Me About Leading",
							"description": "Lessons from reading an hour a day, every day, for more than three years: on focus, consistency, and becoming the kind of leader people want to follow. For leadership teams and anyone trying to build a habit that actually sticks.",
							"formats": "Keynote",
							"highlight": false
						}
					],
					"formats_heading": "Ways I show up",
