---
export const prerender = false;

import { search, getTermsForEntries } from "emdash";
import { isHidden } from "../categories";
import Base from "../layouts/Base.astro";

const query = Astro.url.searchParams.get("q")?.trim() || "";
const { items: found } = query
	? await search(query, { collections: ["posts"], limit: 40 })
	: { items: [] };
// Leave out posts in hidden categories.
const termsById = found.length
	? await getTermsForEntries("posts", found.map((r) => r.id), "category")
	: new Map();
const results = found
	.filter((r) => !isHidden((termsById.get(r.id) ?? []).map((t: { slug: string }) => t.slug)))
	.slice(0, 30);
---

<Base title={query ? `Search: ${query}` : "Search"} description="Search Adam Walker’s writing" robots="noindex">
	<section class="wrap stack" style="max-width: 920px; padding-block: 48px 96px; --stack-gap: 28px;">
		<p class="hand hand--tilt">dig through the notebook</p>
		<h1 class="display" style="font-size: clamp(48px, 7vw, 80px);">Search</h1>
		<form method="get" action="/search" role="search" style="display: flex; gap: 8px; max-width: 620px;">
			<label for="sq" class="sr-only">Search writing</label>
			<input id="sq" name="q" type="search" class="field" value={query} placeholder="Try “reading” or “AI”" />
			<button type="submit" class="btn btn--ink" style="box-shadow: none;">Search</button>
		</form>
		{query && <p class="muted">{results.length} {results.length === 1 ? "result" : "results"} for “{query}”</p>}
		<div>
			{
				results.map((r) => (
					<article class="post-row" style="grid-template-columns: 1fr;">
						<h2 class="row-title"><a href={`/writing/${r.slug ?? r.id}`}>{r.title ?? "Untitled"}</a></h2>
						{r.snippet && <p class="muted" set:html={r.snippet} />}
					</article>
				))
			}
		</div>
	</section>
</Base>
