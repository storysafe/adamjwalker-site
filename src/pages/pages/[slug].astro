---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, { siteTitle, siteUrl: Astro.url.origin, path: Astro.url.pathname.replace(/\/$/, "") });
---

<Base title={seo.title} pageTitle={seo.ogTitle} description={seo.description} canonical={seo.canonical} robots={seo.robots} content={{ collection: "pages", id: page.data.id, slug }}>
	<article class="wrap stack" style="max-width: 760px; padding-block: 56px 96px; --stack-gap: 40px;">
		<h1 class="display" style="font-size: clamp(48px, 7vw, 80px);" {...page.edit.title}>{page.data.title}</h1>
		<div class="prose" {...page.edit.content}>
			<PortableText value={page.data.content} />
		</div>
	</article>
</Base>
