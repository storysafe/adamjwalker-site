---
import Base from "../layouts/Base.astro";
import { PortableText } from "emdash/ui";
import { SUBSTACK_URL } from "../site.config";
import { getPageCopy } from "../page-copy";

const { v, e } = await getPageCopy(Astro, "now_page");

/**
 * Reading streak counts up by itself: 1,323 days on Nov 7, 2026,
 * plus one for every day since (Eastern time). If the streak ever
 * resets, change these two values.
 */
const STREAK_ON = { date: "2026-11-07", days: 1323 };
const todayET = new Intl.DateTimeFormat("en-CA", { timeZone: "America/New_York" }).format(new Date());
const daysSince = Math.round((Date.parse(todayET) - Date.parse(STREAK_ON.date)) / 86_400_000);
const streak = (STREAK_ON.days + Math.max(0, daysSince)).toLocaleString("en-US");
---

<Base title="Now" description="What Adam Walker is focused on right now: work, building, the podcast, reading, and home.">
	<div class="wrap stack" style="max-width: 920px; padding-block: 48px 96px; --stack-gap: 40px;">
		<div style="display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-end; justify-content: space-between;">
			<div class="stack" style="--stack-gap: 12px;">
				<p class="hand hand--tilt" {...e("kicker")}>{v("kicker")}</p>
				<h1 class="display" {...e("heading")}>{v("heading")}</h1>
			</div>
			<div class="updated">
				<span>Last updated</span>
				<strong {...e("updated")}>{v("updated")}</strong>
			</div>
		</div>
		<p class="lead" {...e("lead")}>{v("lead")}</p>

		<div class="notebook">
			<div class="tape" style="margin-left: -65px; width: 130px; background: rgba(224,169,59,.6); transform: rotate(-3deg);"></div>
			<section>
				<h2 {...e("work_heading")}>{v("work_heading")}</h2>
				<div {...e("work_list")}><PortableText value={v("work_list")} /></div>
			</section>
			<section>
				<h2 {...e("building_heading")}>{v("building_heading")}</h2>
				<div {...e("building_list")}><PortableText value={v("building_list")} /></div>
			</section>
			<section>
				<h2 {...e("mic_heading")}>{v("mic_heading")}</h2>
				<div {...e("mic_list")}><PortableText value={v("mic_list")} /></div>
			</section>
			<section>
				<h2 {...e("reading_heading")}>{v("reading_heading")}</h2>
				<ul>
					<li><span {...e("streak_text")}>{v("streak_text")}</span> <strong>{streak} days</strong>.</li>
					<li><span {...e("book_label")}>{v("book_label")}</span> <em {...e("book_title")}>{v("book_title")}</em>.</li>
				</ul>
			</section>
			<section class="home-row">
				<div>
					<h2 {...e("home_heading")}>{v("home_heading")}</h2>
					<div {...e("home_list")}><PortableText value={v("home_list")} /></div>
				</div>
				<figure class="family">
					<div class="tape" style="width: 90px; margin-left: -45px; transform: rotate(4deg);"></div>
					<img src="/images/walker-family.webp" alt="The Walker family: Adam, his wife, and their five kids" width="1000" height="1333" loading="lazy" />
					<figcaption {...e("photo_caption")}>{v("photo_caption")}</figcaption>
				</figure>
			</section>
			<section>
				<h2 {...e("no_heading")}>{v("no_heading")}</h2>
				<div {...e("no_list")}><PortableText value={v("no_list")} /></div>
			</section>
		</div>

		<div class="band-ink" style="display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between; padding: 28px 32px; border-radius: 16px;">
			<div class="stack" style="--stack-gap: 6px;">
				<span class="hand" style="font-size: 26px;" {...e("cta_kicker")}>{v("cta_kicker")}</span>
				<strong style="font-family: var(--font-display); font-size: 26px;" {...e("cta_text")}>{v("cta_text")}</strong>
			</div>
			<a href={SUBSTACK_URL} class="btn btn--gold" {...e("cta_button")}>{v("cta_button")}</a>
		</div>
	</div>
</Base>

<style>
	.updated {
		padding: 14px 18px;
		border: 2.5px solid var(--rust);
		border-radius: 8px;
		color: var(--rust);
		text-align: center;
		transform: rotate(4deg);
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.updated span {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.updated strong {
		font-family: var(--font-display);
		font-size: 22px;
	}
	.notebook {
		position: relative;
		background-color: var(--card);
		background-image: repeating-linear-gradient(transparent 0 35px, rgba(168, 64, 31, 0.14) 35px 36px);
		border: 2px solid var(--ink);
		border-radius: 6px;
		padding: 44px 48px 48px 88px;
		box-shadow: 8px 8px 0 var(--ink);
		display: flex;
		flex-direction: column;
		gap: 36px;
	}
	.notebook::before {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		left: 56px;
		width: 2px;
		background: rgba(168, 64, 31, 0.45);
	}
	.notebook h2 {
		font-family: var(--font-hand);
		font-size: 34px;
		line-height: 1;
		color: var(--rust);
		letter-spacing: 0;
		margin-bottom: 10px;
	}
	.notebook :global(ul) {
		margin: 0;
		padding-left: 1.1em;
		display: flex;
		flex-direction: column;
		gap: 10px;
		font-size: 19px;
	}
	.home-row {
		display: flex;
		flex-wrap: wrap;
		gap: 28px 40px;
		align-items: flex-start;
	}
	.home-row > div {
		flex: 999 1 280px;
		min-width: 0;
	}
	.family {
		position: relative;
		flex: 0 1 260px;
		margin: 0 auto;
		background: #fff;
		padding: 10px 10px 44px;
		box-shadow: 0 1px 0 rgba(31, 42, 46, 0.08), 0 14px 30px rgba(31, 42, 46, 0.16);
		transform: rotate(-2deg);
	}
	.family img {
		display: block;
		width: 100%;
		height: auto;
	}
	.family figcaption {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 8px;
		text-align: center;
		font-family: var(--font-hand);
		font-size: 24px;
	}
	@media (max-width: 600px) {
		.notebook {
			padding: 36px 22px 32px 44px;
		}
		.notebook::before {
			left: 28px;
		}
	}
</style>
