---
import Base from "../layouts/Base.astro";
import { CONTACT_ENDPOINT } from "../site.config";

const sent = Astro.url.searchParams.get("sent") === "1";
const failed = Astro.url.searchParams.get("error") === "1";
const hats = ["Fractional CMO", "Technology Lead", "Both", "I’m a nonprofit", "Not sure yet"];
---

<Base title="Work with me" description="Fractional CMO and Technology Lead for growing businesses, plus practical technology help for nonprofits through Enable Good.">
	<!-- Hero -->
	<section class="wrap" style="padding-block: 56px 80px;">
		<div class="split" style="align-items: flex-end;">
			<div class="grow stack" style="--stack-gap: 24px; flex-basis: 600px;">
				<p class="hand hand--tilt">is your marketing broken?</p>
				<h1 class="display" style="font-size: clamp(52px, 7vw, 84px); line-height: 1;">
					Fractional CMO.<br />Technology Lead.<br /><span class="squiggle">Or both.<svg viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16c40-10 90-12 140-6s100 4 152-6" fill="none" stroke="#E0A93B" stroke-width="7" stroke-linecap="round"></path></svg></span>
				</h1>
				<p class="lead" style="font-size: 21px;">Most teams need someone to lead the message, someone to lead the tools, or both. I’ve founded two marketing agencies (sold one, still growing the other), served as a nonprofit CMO, and led 48in48 as it built 1,700+ nonprofit websites.</p>
				<div class="btn-row">
					<a href="#contact" class="btn btn--ink">Let’s work together</a>
					<a href="#services" class="btn btn--ghost">See how I help</a>
				</div>
			</div>
			<div class="side stack" style="--stack-gap: 14px;">
				<div class="card card--ink" style="transform: rotate(1.5deg); padding: 24px 26px; gap: 4px; border-radius: 14px;">
					<strong style="font-family: var(--font-display); font-size: 52px; line-height: 1; color: var(--gold);">1,700+</strong>
					<span>nonprofit websites built through 48in48 over 11 years</span>
				</div>
				<div class="card" style="transform: rotate(-1deg); padding: 24px 26px; gap: 4px; border-radius: 14px;">
					<strong style="font-family: var(--font-display); font-size: 52px; line-height: 1; color: var(--rust);">2</strong>
					<span style="color: var(--ink-soft);">marketing agencies founded, one sold</span>
				</div>
			</div>
		</div>
	</section>

	<!-- Superpower -->
	<section class="band-strip">
		<div class="wrap stack" style="max-width: 1000px; padding-block: 72px; text-align: center; align-items: center; --stack-gap: 16px;">
			<p class="hand">my superpower</p>
			<p class="italic-serif" style="font-size: clamp(30px, 4vw, 48px); line-height: 1.2;">“I make complex ideas and messages easy to understand.”</p>
		</div>
	</section>

	<!-- For businesses -->
	<section id="services" class="wrap section stack" style="--stack-gap: 40px;">
		<div class="stack" style="--stack-gap: 8px;">
			<p class="hand" style="font-size: 28px;">for businesses</p>
			<h2 class="h-lg">Two ways to work together</h2>
		</div>
		<p class="lead" style="margin-top: -16px; max-width: 720px;">For growing businesses, the help usually comes down to one of two seats at the leadership table: someone to lead your marketing, or someone to lead your technology.</p>
		<div class="grid" style="--min: 320px;">
			<article id="marketing" class="card offer" style="box-shadow: 8px 8px 0 var(--rust);">
				<p class="hand" style="font-size: 28px;">the marketing hat</p>
				<h3 class="h-md" style="font-size: 44px;">Fractional CMO</h3>
				<p class="italic-serif" style="font-size: 23px; line-height: 1.35; color: var(--ink-soft);">Marketing leadership, without hiring a full-time executive.</p>
				<p style="color: var(--ink-soft);">A three-month (or longer) engagement where I lead your marketing team to build and execute a plan.</p>
				<ul class="offer-list">
					<li><strong>Right for you if</strong> your marketing feels broken, or no one owns it</li>
					<li><strong>Engagement</strong> three months or longer</li>
				</ul>
				<a href="#contact" class="btn btn--ink push" style="align-self: flex-start; box-shadow: none;">Talk about marketing →</a>
			</article>
			<article id="technology" class="card card--gold offer" style="box-shadow: 8px 8px 0 var(--ink);">
				<p class="hand" style="font-size: 28px; color: var(--ink);">the technology hat</p>
				<h3 class="h-md" style="font-size: 44px;">Technology Lead</h3>
				<p class="italic-serif" style="font-size: 23px; line-height: 1.35;">A technology plan, and someone to lead it.</p>
				<p>What to buy, what to build, and what to stop paying for, plus putting AI to work without the hype.</p>
				<ul class="offer-list">
					<li><strong>Tech strategy &amp; roadmap</strong></li>
					<li><strong>AI adoption &amp; training</strong></li>
					<li><strong>Websites, systems &amp; tools</strong></li>
				</ul>
				<a href="#contact" class="btn btn--ink push" style="align-self: flex-start; box-shadow: none;">Talk about technology →</a>
			</article>
		</div>
		<div class="chip-row" style="justify-content: center; text-align: center; gap: 12px 20px; padding: 22px 28px; border: 2px dashed var(--ink); border-radius: 14px;">
			<span class="hand">need both?</span>
			<span style="font-size: 18px;">Message and tools usually break together. I can wear both hats.</span>
			<a href="#contact" class="more">Let’s talk →</a>
		</div>
	</section>

	<!-- For nonprofits -->
	<section id="nonprofits" class="band-gold">
		<div class="wrap section stack" style="--stack-gap: 44px;">
			<div style="display: flex; flex-wrap: wrap; gap: 32px 56px; align-items: flex-end; justify-content: space-between;">
				<div class="stack" style="flex: 999 1 560px; min-width: 0; --stack-gap: 14px;">
					<p class="hand hand--tilt" style="font-size: 32px;">for nonprofits</p>
					<h2 class="h-xl">AI without the hype.</h2>
					<p class="lead">Practical technology your staff and volunteers will actually use. Built on 11 years and 1,700+ nonprofit websites with 48in48. My nonprofit work runs through <strong>Enable Good</strong>.</p>
				</div>
				<a href="#contact" class="btn btn--ink" style="box-shadow: 4px 4px 0 var(--card);">Talk nonprofit tech</a>
			</div>
			<div class="grid" style="--min: 250px; --grid-gap: 24px;">
				<article class="card np tilt-l">
					<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#A8401F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20h18"></path><path d="M5 20V10l4-3 4 3v10"></path><path d="M13 20v-6l4-3 2 1.5V20"></path><path d="M9 13v2"></path></svg>
					<h3>Tech strategy &amp; roadmap</h3>
					<p>What to buy, what to build, and what to stop paying for. A clear plan sized to your team and budget.</p>
				</article>
				<article class="card np tilt-r">
					<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#A8401F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z"></path><path d="M19 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"></path></svg>
					<h3>AI adoption &amp; training</h3>
					<p>Hands-on training that shows your staff and volunteers where AI saves real time, and where it doesn’t.</p>
				</article>
				<article class="card np tilt-l">
					<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#A8401F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"></rect><path d="M3 8h18"></path><path d="M8 21h8"></path></svg>
					<h3>Websites &amp; digital</h3>
					<p>Site rebuilds and re-platforms, plus the digital tools that sit around them.</p>
				</article>
				<article class="card np tilt-r">
					<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#A8401F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="2.5"></circle><circle cx="18" cy="6" r="2.5"></circle><circle cx="12" cy="18" r="2.5"></circle><path d="M8 7.5l2.8 8.3"></path><path d="M16 7.5l-2.8 8.3"></path><path d="M8.5 6h7"></path></svg>
					<h3>Systems &amp; tools</h3>
					<p>Choosing and setting up your CRM, donor database, project tools, and automations so the work stops living in inboxes.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- Contact -->
	<section id="contact" class="band-ink">
		<div class="wrap section" style="display: flex; flex-wrap: wrap; gap: 56px;">
			<div class="stack" style="flex: 1 1 380px; --stack-gap: 18px;">
				<p class="hand">let’s talk</p>
				<h2 class="h-lg" style="line-height: 1.05;">Let’s work together &amp; build something awesome.</h2>
				<p class="lead">Tell me what feels broken. I’ll read every note myself.</p>
			</div>
			<form method="post" action={CONTACT_ENDPOINT} class="contact-form">
				<input type="hidden" name="form" value="work-with-me" />
				<label class="sr-only" aria-hidden="true">Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
				{sent && <p class="sent" role="status">Thanks, I’m looking forward to connecting with you.</p>}
				{failed && <p class="sent" role="alert" style="background: var(--rust); color: #fff;">Something went wrong sending that. Please try again.</p>}
				<label class="field-label">Name<input class="field" type="text" name="name" autocomplete="name" required /></label>
				<label class="field-label">Email<input class="field" type="email" name="email" autocomplete="email" required /></label>
				<label class="field-label full">Organization<input class="field" type="text" name="organization" autocomplete="organization" /></label>
				<fieldset class="full">
					<legend class="field-label">Which hat do you need?</legend>
					<div class="chip-row">
						{
							hats.map((h, i) => (
								<label class="chip radio">
									<input type="radio" name="hat" value={h} checked={i === 0} /> {h}
								</label>
							))
						}
					</div>
				</fieldset>
				<label class="field-label full">What’s broken?<textarea class="field" name="message" rows="5" required></textarea></label>
				<div class="full" style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between;">
					<span class="hand" style="font-size: 24px; color: var(--rust);">thanks, I’m looking forward to connecting with you</span>
					<button type="submit" class="btn btn--rust" style="min-height: 56px;">Send it</button>
				</div>
			</form>
		</div>
	</section>
</Base>

<style>
	.offer {
		padding: 40px;
		gap: 18px;
		border-radius: 18px;
	}
	.offer-list {
		list-style: none;
		margin: 0;
		padding: 18px 0 0;
		border-top: 1.5px dashed color-mix(in srgb, currentColor 35%, transparent);
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.np {
		padding: 30px;
		border-radius: 14px;
	}
	.np h3 {
		font-size: 26px;
	}
	.np p {
		color: var(--ink-soft);
	}
	.contact-form {
		flex: 999 1 520px;
		min-width: 0;
		background: var(--card);
		color: var(--ink);
		border-radius: 16px;
		padding: 36px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 18px;
	}
	.contact-form .full,
	.contact-form .sent {
		grid-column: 1 / -1;
	}
	.contact-form fieldset {
		margin: 0;
		padding: 0;
		border: 0;
	}
	.contact-form legend {
		padding-bottom: 10px;
	}
	.contact-form .field-label {
		color: var(--muted);
	}
	.radio {
		gap: 8px;
		font-weight: 500;
		cursor: pointer;
	}
	.sent {
		padding: 14px 18px;
		background: var(--gold);
		border-radius: 10px;
		font-weight: 600;
	}
	@media (max-width: 600px) {
		.contact-form {
			padding: 24px;
		}
	}
</style>
