---
import Base from "../layouts/Base.astro";
import { PODCAST_URL } from "../site.config";
import { getPageCopy } from "../page-copy";

const { v, e } = await getPageCopy(Astro, "podcast_page");
const companies = (v("companies") ?? []) as Array<{ role?: string; name: string; description?: string; url?: string; highlight?: boolean }>;
---

<Base title="Podcast & Companies" description="Tech Talk, Y’all, plus 48in48, Edgewise Media, Together Letters, and Enable Good.">
	<header class="wrap stack" style="padding-block: 48px 40px; --stack-gap: 16px;">
		<p class="hand hand--tilt" {...e("kicker")}>{v("kicker")}</p>
		<h1 class="display" style="font-size: clamp(52px, 7vw, 84px);" {...e("heading")}>{v("heading")}</h1>
	</header>

	<section class="wrap stack" style="padding-bottom: 96px; --stack-gap: 48px;">
		<a href={PODCAST_URL} class="banner">
			<span class="record" aria-hidden="true"><span>TTY</span></span>
			<span class="stack" style="flex: 999 1 380px; min-width: 0; --stack-gap: 12px;">
				<span class="hand" style="font-size: 28px; color: var(--gold);" {...e("show_kicker")}>{v("show_kicker")}</span>
				<strong style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 52px); line-height: 1; letter-spacing: -0.02em;" {...e("show_title")}>{v("show_title")}</strong>
				<span style="font-size: 19px; color: var(--on-ink-soft);" {...e("show_text")}>{v("show_text")}</span>
			</span>
			<span class="btn btn--gold" style="flex: 0 0 auto;" {...e("show_button")}>{v("show_button")}</span>
		</a>

		<div class="stack" style="--stack-gap: 16px;">
			<h2 class="hand" style="font-size: 30px; font-weight: 500;" {...e("companies_kicker")}>{v("companies_kicker")}</h2>
			<div class="grid" style="--min: 260px; --grid-gap: 24px;" {...e("companies")}>
				{
					companies.map((c, i) => (
						<a href={c.url} class:list={["card", "company", { "card--gold": c.highlight }]} style={`transform: rotate(${i % 2 ? 0.5 : -0.5}deg)`}>
							<span class="label" style={c.highlight ? "color: var(--ink);" : undefined}>{c.role}</span>
							<strong>{c.name}</strong>
							<span class="desc">{c.description}</span>
							<span class="more push" style={c.highlight ? "color: var(--ink);" : undefined}>Visit →</span>
						</a>
					))
				}
			</div>
		</div>
	</section>
</Base>

<style>
	.banner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 32px 48px;
		padding: 40px;
		background: var(--ink);
		border-radius: 20px;
		color: var(--on-ink);
		text-decoration: none;
		box-shadow: 8px 8px 0 var(--gold);
	}
	.banner:hover {
		color: var(--on-ink);
	}
	.record {
		flex: 0 0 auto;
		width: 168px;
		height: 168px;
		border-radius: 50%;
		background: repeating-radial-gradient(circle, #2b383d 0 3px, #1a2326 3px 6px);
		border: 3px solid var(--on-ink);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.record span {
		width: 76px;
		height: 76px;
		border-radius: 50%;
		background: var(--gold);
		color: var(--ink);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 22px;
	}
	.company {
		min-height: 220px;
		padding: 28px;
		gap: 10px;
		border-radius: 14px;
	}
	.company strong {
		font-family: var(--font-display);
		font-size: 30px;
		line-height: 1.1;
	}
	.company .desc {
		color: var(--ink-soft);
	}
	.card--gold .desc {
		color: var(--ink);
	}
	@media (max-width: 600px) {
		.banner {
			padding: 28px;
		}
		.record {
			width: 120px;
			height: 120px;
		}
	}
</style>
