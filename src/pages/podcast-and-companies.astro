---
import Base from "../layouts/Base.astro";
import { PODCAST_URL, ENABLE_GOOD_URL, TOGETHER_LETTERS_URL, EDGEWISE_URL } from "../site.config";

const companies = [
	{ role: "Executive Director", name: "48in48", text: "1,700+ nonprofit websites built over 11 years.", href: "https://48in48.org", gold: false },
	{ role: "Podcast production", name: "Edgewise Media", text: "Create marketing content fast through podcasts.", href: EDGEWISE_URL, gold: false },
	{ role: "Stay connected", name: "Together Letters", text: "Stay connected with the people important to you, outside of social media.", href: TOGETHER_LETTERS_URL, gold: false },
	{ role: "My consulting", name: "Enable Good", text: "Marketing and technology consulting for nonprofits.", href: ENABLE_GOOD_URL, gold: true },
];
---

<Base title="Podcast & Companies" description="Tech Talk, Y’all, plus 48in48, Edgewise Media, Together Letters, and Enable Good.">
	<header class="wrap stack" style="padding-block: 48px 40px; --stack-gap: 16px;">
		<p class="hand hand--tilt">things I make &amp; run</p>
		<h1 class="display" style="font-size: clamp(52px, 7vw, 84px);">The Podcast &amp; the Companies</h1>
	</header>

	<section class="wrap stack" style="padding-bottom: 96px; --stack-gap: 48px;">
		<a href={PODCAST_URL} class="banner">
			<span class="record" aria-hidden="true"><span>TTY</span></span>
			<span class="stack" style="flex: 999 1 380px; min-width: 0; --stack-gap: 12px;">
				<span class="hand" style="font-size: 28px; color: var(--gold);">on the mic</span>
				<strong style="font-family: var(--font-display); font-size: clamp(36px, 5vw, 52px); line-height: 1; letter-spacing: -0.02em;">Tech Talk, Y’all</strong>
				<span style="font-size: 19px; color: var(--on-ink-soft);">My podcast, co-hosted with Sanjay Parekh.</span>
			</span>
			<span class="btn btn--gold" style="flex: 0 0 auto;">Listen to the show →</span>
		</a>

		<div class="stack" style="--stack-gap: 16px;">
			<h2 class="hand" style="font-size: 30px; font-weight: 500;">behind the desk</h2>
			<div class="grid" style="--min: 260px; --grid-gap: 24px;">
				{
					companies.map((c, i) => (
						<a href={c.href} class:list={["card", "company", { "card--gold": c.gold }]} style={`transform: rotate(${i % 2 ? 0.5 : -0.5}deg)`}>
							<span class="label" style={c.gold ? "color: var(--ink);" : undefined}>{c.role}</span>
							<strong>{c.name}</strong>
							<span class="desc">{c.text}</span>
							<span class="more push" style={c.gold ? "color: var(--ink);" : undefined}>Visit →</span>
						</a>
					))
				}
			</div>
		</div>
	</section>
</Base>

<style>
	.banner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 32px 48px;
		padding: 40px;
		background: var(--ink);
		border-radius: 20px;
		color: var(--on-ink);
		text-decoration: none;
		box-shadow: 8px 8px 0 var(--gold);
	}
	.banner:hover {
		color: var(--on-ink);
	}
	.record {
		flex: 0 0 auto;
		width: 168px;
		height: 168px;
		border-radius: 50%;
		background: repeating-radial-gradient(circle, #2b383d 0 3px, #1a2326 3px 6px);
		border: 3px solid var(--on-ink);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.record span {
		width: 76px;
		height: 76px;
		border-radius: 50%;
		background: var(--gold);
		color: var(--ink);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 22px;
	}
	.company {
		min-height: 220px;
		padding: 28px;
		gap: 10px;
		border-radius: 14px;
	}
	.company strong {
		font-family: var(--font-display);
		font-size: 30px;
		line-height: 1.1;
	}
	.company .desc {
		color: var(--ink-soft);
	}
	.card--gold .desc {
		color: var(--ink);
	}
	@media (max-width: 600px) {
		.banner {
			padding: 28px;
		}
		.record {
			width: 120px;
			height: 120px;
		}
	}
</style>
