---
import { getEmDashEntry, getEmDashCollection, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Fedora from "../../components/Fedora.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import { formatDate } from "../../utils/locale";
import { getReadingTime, formatReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { visiblePosts } from "../../utils/posts";
import { summarize } from "../../utils/summary";
import { groupForPost, isHidden } from "../../categories";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

function imageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const key = (typeof meta?.storageKey === "string" ? meta.storageKey : undefined) || (typeof image.id === "string" ? image.id : undefined);
	return key ? `${Astro.url.origin}/_emdash/api/media/file/${key}` : undefined;
}

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: imageUrl(post.data.featured_image),
});
// Explicit SEO description, then excerpt, then the post's opening sentences.
const description = (post.data as any).seo?.description || summarize(post.data.content, post.data.excerpt) || seo.description;

const postSlugs = (post.data.terms?.category ?? []).map((t: { slug: string }) => t.slug);
const hidden = isHidden(postSlugs);
const category = hidden ? null : groupForPost(postSlugs);
const publishedAt = post.data.publishedAt ?? null;
const readingTime = formatReadingTime(getReadingTime(post.data.content));

// Related: newest visible posts in the same group (or overall).
const { entries: recent, cacheHint: recentHint } = await getEmDashCollection("posts", {
	...(category ? { where: { category: category.members } } : {}),
	orderBy: { published_at: "desc" },
	limit: 8,
});
if (Astro.cache?.enabled) Astro.cache.set(recentHint);
const related = (await visiblePosts(recent)).map((p) => p.post).filter((p) => p.id !== post.id).slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={publishedAt?.toISOString()}
	modifiedTime={post.data.updatedAt?.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug: post.id }}
>
	<article>
		<header class="wrap stack" style="max-width: 920px; padding-block: 56px 40px; align-items: center; text-align: center; --stack-gap: 24px;">
			{category && <a href={`/writing/category/${category.slug}`} class="stamp" style="align-self: center;">{category.label}</a>}
			<h1 class="display" style="font-size: clamp(40px, 6vw, 68px); line-height: 1.04;" {...post.edit.title}>{post.data.title}</h1>
			{post.data.excerpt && <p class="lead" style="margin-inline: auto;" {...post.edit.excerpt}>{post.data.excerpt}</p>}
			<div style="display: flex; align-items: center; gap: 14px; color: var(--muted);">
				<span class="avatar"><Fedora width={26} color="#E0A93B" accent="#E0A93B" strokeWidth={3.5} pinch={false} /></span>
				<span>
					By <strong style="color: var(--ink);">Adam Walker</strong>
					{publishedAt && <> · <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, "long")}</time></>}
					{" · "}{readingTime}
				</span>
			</div>
		</header>

		{
			post.data.featured_image && (
				<div class="wrap" style="max-width: 1100px;">
					<figure class="hero-photo" {...post.edit.featured_image}>
						<div class="tape" style="left: 14%;"></div>
						<div class="tape" style="left: auto; right: 4%; transform: rotate(5deg);"></div>
						<Image image={post.data.featured_image} sizes="(min-width: 1100px) 1072px, 100vw" priority />
					</figure>
				</div>
			)
		}

		<div class="wrap" style="max-width: 728px; padding-block: 72px 24px;">
			<div class="prose" {...post.edit.content}>
				<PortableText value={post.data.content} />
			</div>
		</div>
	</article>

	<section class="wrap" style="max-width: 760px; padding-block: 48px;">
		<div class="card card--shadow" style="position: relative; padding: 40px; border-radius: 6px; box-shadow: 8px 8px 0 var(--ink); transform: rotate(0.4deg);">
			<span class="postmark" aria-hidden="true"><Fedora width={44} color="var(--rust)" pinch={false} /></span>
			<p class="hand">liked this one?</p>
			<h2 class="h-md" style="max-width: 480px;">Get the next one in your inbox every week.</h2>
			<SubscribeForm id="post-email" label="Email address" variant="rust" />
		</div>
	</section>

	<section class="wrap" style="max-width: 760px; padding-block: 32px 64px;">
		<div style="display: flex; flex-wrap: wrap; gap: 24px; align-items: center; padding: 28px 0; border-block: 2px solid var(--ink);">
			<img src="/images/adam-avatar.webp" alt="" width="96" height="96" loading="lazy" style="flex: 0 0 96px; width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 2px solid var(--ink);" />
			<div class="stack" style="flex: 1 1 300px; --stack-gap: 6px;">
				<strong style="font-family: var(--font-display); font-size: 24px;">Adam Walker</strong>
				<span style="color: var(--ink-soft);">Husband. Father of five. Wearer of fedoras. Helper of nonprofits. Fractional CMO, Technology Lead, and Executive Director of 48in48.</span>
			</div>
		</div>
	</section>

	{
		related.length > 0 && (
			<section class="wrap stack" style="padding-block: 24px 96px; --stack-gap: 28px;">
				<h2 class="h-md">Keep reading</h2>
				<div class="grid">
					{related.map((p, i) => (
						<a href={`/writing/${p.id}`} class="index-card related" style={`transform: rotate(${[-0.5, 0.5, -0.3][i]}deg)`}>
							<strong style="font-family: var(--font-display); font-size: 26px; line-height: 1.2;">{p.data.title}</strong>
							{p.data.excerpt && <span style="color: var(--ink-soft); font-size: 16px;">{p.data.excerpt}</span>}
						</a>
					))}
				</div>
			</section>
		)
	}
</Base>

<style>
	.avatar {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--ink);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
	}
	.hero-photo {
		position: relative;
		margin: 0;
		background: var(--card);
		padding: 14px;
		box-shadow: 0 18px 40px rgba(31, 42, 46, 0.14);
		transform: rotate(-0.6deg);
	}
	.hero-photo :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.postmark {
		position: absolute;
		top: 22px;
		right: 24px;
		width: 72px;
		height: 84px;
		border: 2px dashed var(--rust);
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		transform: rotate(6deg);
	}
	.related {
		color: var(--ink);
		text-decoration: none;
	}
	.related:hover strong {
		color: var(--rust);
	}
	@media (max-width: 600px) {
		.postmark {
			display: none;
		}
	}
</style>
