---
// Old WordPress category archives (/category/productivity/) → display groups
import { groupForMember } from "../../categories";

const parts = (Astro.params.slug ?? "").split("/").filter(Boolean);
const group = groupForMember(parts[parts.length - 1] ?? "");
return Astro.redirect(group ? `/writing/category/${group.slug}` : "/writing", 301);
---
