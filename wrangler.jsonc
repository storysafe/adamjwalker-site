{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "adamjwalker-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true, "head_sampling_rate": 1 },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "adamjwalker-site",
		},
	],
	"kv_namespaces": [{ "binding": "SESSION", "id": "2fc0e700724f49bab44ca5a081140f61" }],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "adamjwalker-media",
		},
	],
	// Contact + speaking forms → Cloudflare Email Service (sending domain: mail.adamjwalker.com).
	// adamjwalker.com inbound mail stays on Microsoft 365; do not enable Email Routing.
	"send_email": [{ "name": "EMAIL" }],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
