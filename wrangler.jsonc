{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "adamjwalker-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "adamjwalker-site",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "adamjwalker-media",
		},
	],
	// Contact + speaking forms: SEND_EMAIL binding is added once outbound email is set up.
	// adamjwalker.com mail runs on Microsoft 365, so Email Routing (which replaces MX) must stay off.
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
